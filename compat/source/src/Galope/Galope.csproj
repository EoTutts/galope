<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <Content Include="../../assets/audio/*.ogg" Link="assets/audio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/sprites/*.gsp" Exclude="../../assets/sprites/obstacle-?.gsp;../../assets/sprites/festival.gsp;../../assets/sprites/pitbull-?.gsp" Link="assets/sprites/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
